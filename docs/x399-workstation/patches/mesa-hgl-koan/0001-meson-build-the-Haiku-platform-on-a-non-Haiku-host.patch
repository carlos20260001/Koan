From 27fb2b5870382137f72f32121ef474268bd4549b Mon Sep 17 00:00:00 2001
From: carlos20260001 <carlosforgithub2026@outlook.com>
Date: Sun, 22 Nov 2026 13:42:30 +0100
Subject: [PATCH 1/3] meson: build the Haiku platform on a non-Haiku host

Koan (VitruvianOS on Linux) runs the BeAPI on Linux, so the Haiku
platform - libGL with BGLView, the hgl frontend and winsys, and the
renderer add-ons - is built on a Linux host. Its SDK is not where the
compiler looks by default there: the new haiku-sdk-args and
haiku-sdk-link-args options carry its include paths, defines and
libraries, and libnetwork is not needed because the sockets are in libc.
On Haiku the old lookups are kept.

haiku-lib-suffix renames libGL and libglapi, so that they do not share a
name with the host's own libGL.so.1 (glvnd) and libglapi.so.0.
---
 meson.build                                   | 22 ++++++++++++++++++-
 meson_options.txt                             | 18 +++++++++++++++
 src/gallium/frontends/hgl/meson.build         |  1 +
 .../targets/haiku-softpipe/meson.build        |  4 +---
 src/gallium/targets/haiku-zink/meson.build    |  4 +---
 src/gallium/winsys/sw/hgl/meson.build         |  1 +
 src/hgl/meson.build                           |  5 ++---
 src/mapi/shared-glapi/meson.build             |  2 +-
 8 files changed, 46 insertions(+), 11 deletions(-)

diff --git a/meson.build b/meson.build
index 4d365a27..07e35674 100644
--- a/meson.build
+++ b/meson.build
@@ -1554,8 +1554,28 @@ else
   dep_regex = null_dep
 endif
 
+# Koan: the Haiku platform on a non-Haiku host (VitruvianOS/Koan on Linux).
+# The BeAPI SDK comes from the haiku-sdk-* options instead of the system
+# compiler's default paths, and the sockets live in libc.
+dep_haiku_sdk = null_dep
+haiku_lib_suffix = get_option('haiku-lib-suffix')
 if with_platform_haiku
-  dep_network = cc.find_library('network')
+  if host_machine.system() == 'haiku'
+    dep_network = cc.find_library('network')
+    dep_haiku_sdk = declare_dependency(
+      include_directories : include_directories('/boot/system/develop/headers/private'),
+      dependencies : [
+        cpp.find_library('be'), cpp.find_library('game'),
+        cpp.find_library('translation'), dep_network,
+      ],
+    )
+  else
+    dep_network = null_dep
+    dep_haiku_sdk = declare_dependency(
+      compile_args : get_option('haiku-sdk-args'),
+      link_args : get_option('haiku-sdk-link-args'),
+    )
+  endif
 endif
 
 # Check for libdrm. Various drivers have different libdrm version requirements,
diff --git a/meson_options.txt b/meson_options.txt
index 1f6ef385..854215fb 100644
--- a/meson_options.txt
+++ b/meson_options.txt
@@ -509,3 +509,21 @@ option(
   value : false,
   description : 'Build vulkan drivers with BETA extensions enabled.'
 )
+option(
+  'haiku-sdk-args',
+  type : 'array',
+  value : [],
+  description : 'Koan: compiler arguments (include paths, defines) for the BeAPI SDK when the Haiku platform is built on a non-Haiku host.'
+)
+option(
+  'haiku-sdk-link-args',
+  type : 'array',
+  value : [],
+  description : 'Koan: linker arguments (-L, -l) for the BeAPI SDK when the Haiku platform is built on a non-Haiku host.'
+)
+option(
+  'haiku-lib-suffix',
+  type : 'string',
+  value : '',
+  description : 'Koan: suffix for libGL and libglapi of the Haiku platform, so they do not share a name with the host system\'s GL libraries.'
+)
diff --git a/src/gallium/frontends/hgl/meson.build b/src/gallium/frontends/hgl/meson.build
index 89877158..a5a0ac0a 100644
--- a/src/gallium/frontends/hgl/meson.build
+++ b/src/gallium/frontends/hgl/meson.build
@@ -38,5 +38,6 @@ libsthgl = static_library(
     inc_gallium, inc_gallium_aux
   ],
   c_args : [libsthgl_c_args],
+  dependencies : dep_haiku_sdk,
   gnu_symbol_visibility : 'hidden',
 )
diff --git a/src/gallium/targets/haiku-softpipe/meson.build b/src/gallium/targets/haiku-softpipe/meson.build
index 2495779c..a4efbb14 100644
--- a/src/gallium/targets/haiku-softpipe/meson.build
+++ b/src/gallium/targets/haiku-softpipe/meson.build
@@ -24,7 +24,6 @@ libswpipe = shared_library(
   include_directories : [
     inc_include, inc_src, inc_mapi, inc_mesa, inc_gallium, inc_gallium_aux, inc_util, inc_haikugl, inc_gallium_drivers, inc_gallium_winsys,
     include_directories('../../frontends/hgl'),
-    include_directories('/boot/system/develop/headers/private')
   ],
   gnu_symbol_visibility : 'hidden',
   link_args : [ld_args_bsymbolic, ld_args_gc_sections],
@@ -33,8 +32,7 @@ libswpipe = shared_library(
     libmesa, libglsl, libgallium, libgl
   ],
   dependencies : [
-    driver_swrast, cpp.find_library('be'), cpp.find_library('translation'),
-    cpp.find_library('network'), dep_unwind, idep_mesautil, idep_nir,
+    driver_swrast, dep_haiku_sdk, dep_unwind, idep_mesautil, idep_nir,
   ],
   install : true,
 )
diff --git a/src/gallium/targets/haiku-zink/meson.build b/src/gallium/targets/haiku-zink/meson.build
index 5e195e69..b5806099 100644
--- a/src/gallium/targets/haiku-zink/meson.build
+++ b/src/gallium/targets/haiku-zink/meson.build
@@ -11,7 +11,6 @@ libzinkpipe = shared_library(
     inc_include, inc_src, inc_mapi, inc_mesa, inc_gallium, inc_gallium_aux,
     inc_util, inc_haikugl, inc_gallium_drivers, inc_gallium_winsys,
     include_directories('../../frontends/hgl'),
-    include_directories('/boot/system/develop/headers/private')
   ],
   gnu_symbol_visibility : 'hidden',
   link_args : [ld_args_bsymbolic, ld_args_gc_sections],
@@ -20,8 +19,7 @@ libzinkpipe = shared_library(
     libmesa, libglsl, libgallium, libgl
   ],
   dependencies : [
-    driver_zink, driver_swrast, cpp.find_library('be'), cpp.find_library('game'),
-    cpp.find_library('translation'), cpp.find_library('network'),
+    driver_zink, driver_swrast, dep_haiku_sdk,
     dep_unwind, idep_mesautil, idep_nir, idep_xmlconfig,
   ],
   install : true,
diff --git a/src/gallium/winsys/sw/hgl/meson.build b/src/gallium/winsys/sw/hgl/meson.build
index 81dcf5bb..9140e48c 100644
--- a/src/gallium/winsys/sw/hgl/meson.build
+++ b/src/gallium/winsys/sw/hgl/meson.build
@@ -25,5 +25,6 @@ libswhgl = static_library(
   include_directories : [inc_gallium, inc_include, inc_src, inc_gallium_aux,
     include_directories('../../../frontends/hgl')
   ],
+  dependencies : dep_haiku_sdk,
   build_by_default : false,
 )
diff --git a/src/hgl/meson.build b/src/hgl/meson.build
index eeecbe03..782f2e67 100644
--- a/src/hgl/meson.build
+++ b/src/hgl/meson.build
@@ -19,17 +19,16 @@
 # SOFTWARE.
 
 libgl = shared_library(
-  'GL',
+  'GL' + haiku_lib_suffix,
   files(
     'GLView.cpp', 'GLRenderer.cpp', 'GLRendererRoster.cpp',
   ),
   link_args : [ld_args_bsymbolic, ld_args_gc_sections],
   include_directories : [
     inc_src, inc_mapi, inc_mesa, inc_include, inc_glapi, inc_haikugl,
-    include_directories('/system/develop/headers/private')
   ],
   link_with : [libglapi_static, libglapi],
-  dependencies : cpp.find_library('be'),
+  dependencies : dep_haiku_sdk,
   version : '1.0.0',
   install : true,
 )
diff --git a/src/mapi/shared-glapi/meson.build b/src/mapi/shared-glapi/meson.build
index 4a13bace..b1b6c1c5 100644
--- a/src/mapi/shared-glapi/meson.build
+++ b/src/mapi/shared-glapi/meson.build
@@ -42,7 +42,7 @@ if with_platform_windows
 endif
 
 libglapi = shared_library(
-  'glapi',
+  'glapi' + (with_platform_haiku ? haiku_lib_suffix : ''),
   [files_mapi_glapi, files_mapi_util, shared_glapi_mapi_tmp_h],
   c_args : [
     _glapi_c_args,
