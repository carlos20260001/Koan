resource app_signature "application/x-vnd.Vitruvian-NotificationReplicant";

resource app_version {
	major  = 1,
	middle = 0,
	minor  = 0,

	variety = B_APPV_ALPHA,
	internal = 0,

	short_info = "Notification Replicant",
	long_info  = "Notification Replicant shows notifications from notification_server"
};

resource app_flags B_SINGLE_LAUNCH | B_BACKGROUND_APP;

