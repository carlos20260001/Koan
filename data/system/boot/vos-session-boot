#!/bin/sh
# Fires the graphical chain after janus is up in user mode.
# Implements XDG Base Directory spec (basedir-spec) environment.

# Verify the login manager's runtime directory before using its sockets.
if [ -z "${XDG_RUNTIME_DIR}" ]; then
    XDG_RUNTIME_DIR="/run/user/$(id -u)"
    export XDG_RUNTIME_DIR
fi
if [ -L "$XDG_RUNTIME_DIR" ] || [ ! -d "$XDG_RUNTIME_DIR" ]; then
    echo "vos-session-boot: XDG_RUNTIME_DIR is not a directory: $XDG_RUNTIME_DIR" >&2
    exit 1
fi
runtime_owner=$(stat -c '%u' "$XDG_RUNTIME_DIR") || exit 1
runtime_mode=$(stat -c '%a' "$XDG_RUNTIME_DIR") || exit 1
if [ "$runtime_owner" != "$(id -u)" ] || [ "$runtime_mode" != "700" ]; then
    echo "vos-session-boot: XDG_RUNTIME_DIR must be owned by the session user with mode 0700" >&2
    exit 1
fi


set -e

# Small wait so janus's daemon_loop has claimed the port before we send.
for i in 1 2 3 4 5; do
	if [ -e "${XDG_RUNTIME_DIR:-/run/vos}/vos/janus.ready" ] \
			|| [ -e /run/vos/janus.ready ]; then
		break
	fi
	sleep 0.2
done

LAUNCH=/system/servers/janus_launch

# WirePlumber registers the Bluetooth audio endpoints (A2DP/HSP) with
# PipeWire; without it a connected headset never becomes an audio device
# the media kit can see. Socket activation covers pipewire itself; this
# makes both explicit for the session, no-op if already running.
systemctl --user --no-block start pipewire.socket wireplumber.service \
	2>/dev/null || true

"$LAUNCH" registrar
"$LAUNCH" app_server
"$LAUNCH" input_server
"$LAUNCH" mount_server
"$LAUNCH" notification_server
"$LAUNCH" keystore_server
"$LAUNCH" Deskbar
"$LAUNCH" Tracker
