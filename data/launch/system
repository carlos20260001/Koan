service x-vnd.vos-registrar {
	launch /system/servers/registrar
	port auth {
		capacity 100
	}
}

service x-vnd.vos-debug_server {
	launch /system/servers/debug_server
}

service x-vnd.vos-package_daemon {
	launch /system/servers/package_daemon
}

service x-vnd.vos-SystemLogger {
	launch /system/servers/syslog_daemon
	port logger {
		capacity 256
	}
}

service x-vnd.vos-mount_server {
	launch /system/servers/mount_server
}

service x-vnd.vos-mcp_server {
	launch /system/servers/mcp_server
	no_safemode
	on initial_volumes_mounted
}

service x-vnd.vos-media_server {
	launch /system/servers/media_server
	no_safemode
	legacy
	on initial_volumes_mounted
}

service x-vnd.vos-midi_server {
	launch /system/servers/midi_server
	no_safemode
	on_demand
}

service x-vnd.vos-bluetooth_server {
	launch /system/servers/bluetooth_server
	no_safemode
	legacy
	on initial_volumes_mounted
}

service x-vnd.vos-net_server {
	launch /system/servers/net_server
	no_safemode
	legacy
}

service x-vnd.Be-PSRV {
	launch /system/servers/print_server
	no_safemode
	on_demand
}

service x-vnd.vos-location_server {
	launch /system/servers/location_server
	no_safemode
	on_demand
}

service x-vnd.vos-mdns_server {
	launch /system/servers/mdns_server
	no_safemode
	on_demand
}

service x-vnd.vos-notification_server {
	launch /system/servers/notification_server
	no_safemode
	on_demand
}

service x-vnd.vos-media_controls_server {
	launch /system/servers/media_controls_server
	no_safemode
	on_demand
}

# air/OS: started when an assistive technology (the screen reader) subscribes;
# it quits again once the last one has left (docs/airos/ACCESSIBILITY.md)
service x-vnd.vos-accessibility_server {
	launch /system/servers/accessibility_server
	no_safemode
	on_demand
}

service x-vnd.vos-osd_server {
	launch /system/servers/osd_server
	no_safemode
	on_demand
}

service x-vnd.vos-quick_look_server {
	launch /system/servers/quick_look_server
	no_safemode
	on_demand
}

service x-vnd.vos-power_daemon {
	launch /system/servers/power_daemon
	no_safemode
	legacy
}

job x-vnd.vos-cddb_lookup {
	launch /system/bin/cddb_lookup
	no_safemode
	on volume_mounted
}

# target login
job x-vnd.vos-autologin {
	launch /system/bin/autologin
}
